          ],
          "path": [
            "signup"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"El método PUT recibe una respuesta controlada\", function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 400, 403, 405, 500]);",
              "});",
              "",
              "pm.test(\"La respuesta no está vacía\", function () {",
              "    pm.expect(pm.response.text().length).to.be.above(0);",
              "});",
              "",
              "pm.test(\"El tiempo de respuesta es inferior a 3000 ms\", function () {",
              "    pm.expect(pm.response.responseTime).to.be.below(3000);",
              "});"
            ]
          }
        }
      ]
    },
